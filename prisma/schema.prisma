generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum ContentKind {
  article
  guide
  report
  area
  tool
}

enum ContentStatus {
  draft
  published
  unpublished
  archived
}

enum ToolSettingType {
  number
  text
  boolean
}

model AdminUser {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String?
  passwordHash String         @map("password_hash")
  role         AdminRole      @default(ADMIN)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id          Int       @id @default(autoincrement())
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUserId Int       @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Category {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(120)
  slug        String        @unique @db.VarChar(160)
  description String?
  createdAt   DateTime      @default(now()) @map("createdAt")
  content     ContentItem[]

  @@map("categories")
}

model User {
  id           Int           @id @default(autoincrement())
  openId       String        @unique @db.VarChar(64)
  name         String?
  email        String?       @db.VarChar(320)
  loginMethod  String?       @db.VarChar(64)
  role         UserRole      @default(user)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  lastSignedIn DateTime      @default(now())
  content      ContentItem[]

  @@map("users")
}

model ContentItem {
  id              Int           @id @default(autoincrement())
  kind            ContentKind
  title           String        @db.VarChar(240)
  slug            String        @unique @db.VarChar(240)
  excerpt         String?
  content         String?
  status          ContentStatus @default(draft)
  featuredImage   String?
  imageAlt        String?       @db.VarChar(240)
  seoTitle        String?       @db.VarChar(240)
  metaDescription String?       @db.VarChar(320)
  canonicalUrl    String?       @db.VarChar(500)
  authorId        Int?
  author          User?         @relation(fields: [authorId], references: [id])
  categoryId      Int?
  category        Category?     @relation(fields: [categoryId], references: [id])
  tags            ContentTag[]
  faqs            Faq[]
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([kind])
  @@index([categoryId])
  @@index([authorId])
  @@map("contentItems")
}

model Tag {
  id      Int           @id @default(autoincrement())
  name    String        @db.VarChar(100)
  slug    String        @unique @db.VarChar(120)
  content ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId Int         @map("contentId")
  tagId     Int         @map("tagId")
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("contentTags")
}

model Faq {
  id        Int         @id @default(autoincrement())
  contentId Int         @map("contentId")
  question  String      @db.VarChar(300)
  answer    String
  sortOrder Int         @default(0) @map("sortOrder")
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("faqs")
}

model Media {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String?  @db.VarChar(240)
  altText   String?  @db.VarChar(240)
  createdBy Int?     @map("createdBy")
  createdAt DateTime @default(now()) @map("createdAt")

  @@map("media")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(120)
  value     String?
  isPublic  Boolean  @default(false) @map("isPublic")
  updatedAt DateTime @default(now()) @map("updatedAt")

  @@map("siteSettings")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(320)
  status    String   @default("active") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([status])
  @@map("subscribers")
}

model ToolSetting {
  id          Int             @id @default(autoincrement())
  toolSlug    String          @map("toolSlug") @db.VarChar(160)
  key         String          @db.VarChar(120)
  label       String          @db.VarChar(180)
  value       String
  type        ToolSettingType @default(text)
  description String?
  updatedAt   DateTime        @updatedAt @map("updatedAt")

  @@unique([toolSlug, key])
  @@index([toolSlug])
  @@map("toolSettings")
}
